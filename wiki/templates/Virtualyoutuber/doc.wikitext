<!-- Template Description -->
==Syntax==
{{T|Virtualyoutuber|v1=PAGENAME|v2=link text}}<br/>
{{T|VTW|v1=PAGENAME|v2=link text}}<br/>
{{T|VLW|v1=PAGENAME|v2=link text}}<br/>
{{T|VTuberW|v1=PAGENAME|v2=link text}}<br/>

==Examples==
{{T|Virtualyoutuber|p1=Regis Altare|p2=Altare (Holostars)|_Y_=1}}<br/>
{{T|VTW|p1=Regis Altare|p2=Regis Altare (Holostars)|_Y_=1}}<br/>
{{T|VYW|p1=Hoshikawa Sara|Hoshikawa Sara (Nijisanji)|_Y_=1}}<br/>
{{T|VTuberW|Hoshikawa Sara|Hoshikawa (Nijisanji)|_Y_=1}}<br/>

