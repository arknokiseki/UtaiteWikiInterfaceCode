{{anchor|{{#sub:{{{albumtitle}}}||{{#pos:{{{albumtitle}}}|~}}}}}}{{anchor|{{#sub:{{{albumtitle}}}||{{#pos:{{{albumtitle}}}|(}}}}}}{{anchor|{{{albumtitle}}}}}

<div style="float:left; clear:left; margin:auto">
<infobox theme="album">
	<group>
		<header>{{{albumtitle}}}</header>
		<image source="image"/>
	</group>
	<group collapse="closed">
		<header>Alternative CD covers</header>
		<image source="imagealt"/>
		<image source="image3"/>
		<image source="image4"/>
		<image source="image5"/>
	</group>
	<group row-items="1">
	    <data source="albumdescr"><format><center>{{{albumdescr|}}}</center></format></data>
		<data source="albumartist"><format><center>Illust. by {{{albumartist}}}</center></format></data>
	<data source="datereleased"><format><center>Released on {{{datereleased}}}</center></format></data>
		<data source=""><default><center>Crossfade: {{#if: {{{crossfadeyt|}}} | [[File:yt.png{{!}}link{{=}}http://www.youtube.com/watch?v{{=}}{{{crossfadeyt}}}]]|[[File:NoYt.png|link=]]}}{{#if: {{{crossfadennd|}}} | {{nnd|{{{crossfadennd}}}}}|[[File:NoNv.png|link=]]}}</center></default></data>
	
	</group>
<group>
	
	<!--STREAMING SERVICES SECTION-->
	
<header>Streaming Services</header>
<data source="streams"><format>{{#if:{{{streams|}}}|{{{streams}}}&nbsp;|}}
</format>
<default>No streaming media available yet</default>
</data>

<!--SHOPS SECTION-->

<header>Shops</header>
<data source="shops"><format>{{#if:{{{shops|}}}|{{{shops}}}&nbsp;|}}</format>
	<default>No shops available yet</default>
</data>

	<!--DOWNLOADS SECTION-->
<header>Downloads</header>
<data source="download"><format>{{#if:{{{download|}}}|{{{download}}}&nbsp;|}}
</format>
<default>No downloads available yet</default>
</data>

</group>
</infobox></div>
