  |nico   = sm
  |nico2  = /Name
  |vocadb = ok
  |utadb  = ok
  |mgp    = 
  |pixiv  = 
  |tag    = 
  |vlw    = {{>subst:PAGENAME}}
  |url    = [url name]
}}
</pre>

