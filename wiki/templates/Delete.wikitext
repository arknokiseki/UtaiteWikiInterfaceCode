und:#fff3cd;border:1px solid #ffeaa7;border-radius:calc(var(--border-radius) - 2px);padding:1em;color:#856404;font-weight:bold">If no information is added by {{{deletiondate|YYYY-MM-DD}}} ({{Time ago|{{{deletiondate}}}}}), this page will be deleted.</div>|}}</div>{{#ifeq:{{PAGENAME}}|Delete/doc||{{#ifeq:{{PAGENAME}}|Delete||[[Category:Candidates for deletion]]}}}}</includeonly><noinclude>
