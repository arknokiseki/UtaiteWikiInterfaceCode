{{anchor|{{{nameeng}}}}}
<div style="float:left; clear:left; margin:auto"><infobox theme="anikora">
	<group row-items="1">
	<header><center>{{#if:{{{namejap|}}}|{{{namejap}}}<br>}}{{{nameeng}}}</center></header>
	<data source="openingnnd"><format><center>http://tn-skr1.smilevideo.jp/smile?i={{#sub:{{{openingnnd}}}|2|15}}&dummy.jpg</center></format></data>
	<data source="endingnnd"><format><center>http://tn-skr1.smilevideo.jp/smile?i={{#sub:{{{endingnnd}}}|2|15}}&dummy.jpg</center></format></data>
	</group>
	<group row-items="1">
		<data source="date"><format><center>{{{date}}}</center></format></data>
	</group>
	<group row-items="2">
		<header><center>Opening/Ending</center></header>
		<data source=""><default><center>{{#if: {{{openingyt|}}} | [[File:yt.png{{!}}link{{=}}http://www.youtube.com/watch?v{{=}}{{{openingyt}}}]]|[[File:NoYt.png|link=]]}}{{#if: {{{openingnnd|}}} | {{nnd|{{{openingnnd}}}}}|[[File:NoNv.png|link=]]}}</center></default></data>
		<data source=""><default><center>{{#if: {{{endingyt|}}} | [[File:yt.png{{!}}link{{=}}http://www.youtube.com/watch?v{{=}}{{{endingyt}}}]]|[[File:NoYt.png|link=]]}}{{#if: {{{endingnnd|}}} | {{nnd|{{{endingnnd}}}}}|[[File:NoNv.png|link=]]}}</center></default></data>
		<data source="mylist"><format><center>[http://www.nicovideo.jp/mylist/{{{mylist}}} mylist/{{{mylist}}}]</center></format></data>
	</group>
</infobox></div>
